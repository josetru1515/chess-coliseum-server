rules_version = '2';

// ─── Reglas de seguridad — World of Chesscraft ──────────────────
// Proyecto compartido por mundo-frontend y chess_coliseum_pro.
// Antes: base de datos COMPLETAMENTE abierta (cualquiera podía leer,
// editar y borrar todo). Ahora cada colección permite solo lo que las
// apps realmente hacen.
//
// Desplegar con:  firebase deploy --only firestore:rules
// (desde la carpeta chess_coliseum_pro)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Anti-trampa del oro (protección provisional vía reglas; lo robusto será una
    // Cloud Function antes de abrir al público). Reglas:
    //  1) el oro nunca puede ser negativo
    //  2) el oro nunca puede pasar de 100.000
    //  3) un solo cambio no puede SUMAR más que el premio máximo legítimo (PvP 1500 + margen)
    //  Si el oro no cambia (presencia, apodo, skins…), siempre se permite.
    function goldOk() {
      let oldGold = resource == null ? 0 : resource.data.get('gold', 0);
      let newGold = request.resource.data.get('gold', 0);
      return newGold == oldGold
        || (newGold >= 0 && newGold <= 100000 && newGold <= oldGold + 2000);
    }

    // ── Usuarios: perfil, amigos, skins, presencia ──────────
    match /users/{uid} {
      // Lectura: cualquier usuario autenticado (búsqueda por email,
      // lista de amigos, presencia en línea).
      allow read: if signedIn();

      // Crear: solo tu propio documento (registro).
      allow create: if signedIn() && request.auth.uid == uid && goldOk();

      // Actualizar tu propio documento: skins, presencia, perfil… con el oro acotado.
      allow update: if signedIn() && request.auth.uid == uid && goldOk();

      // Actualizar el documento de OTRO usuario: únicamente para
      // añadirte a ti mismo a su lista 'friends' (aceptar solicitud).
      // No puede tocar otros campos, ni quitar amigos existentes,
      // ni añadir a nadie que no sea él mismo.
      allow update: if signedIn() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && request.resource.data.friends is list
        && request.resource.data.friends.toSet().difference(resource.data.get('friends', []).toSet()) == [request.auth.uid].toSet()
        && resource.data.get('friends', []).toSet().difference(request.resource.data.friends.toSet()).size() == 0;

      allow delete: if false;
    }

    // ── Solicitudes de amistad ──────────────────────────────
    match /friendRequests/{reqId} {
      // Crear: solo en tu nombre.
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      // Leer/actualizar/borrar: solo los dos implicados.
      allow read, update, delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ── Desafíos PvP ────────────────────────────────────────
    match /gameChallenges/{challengeId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read, update, delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ── Invitaciones a jugadores aún sin cuenta ─────────────
    match /pendingInvitations/{inviteId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // ── Todo lo demás: denegado ─────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
